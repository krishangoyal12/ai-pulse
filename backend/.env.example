# AI Pulse Backend Configuration Template
# Copy this file to backend/.env and populate with your credentials.

SECRET_KEY=change-me-to-a-secure-random-secret
DATABASE_URL=sqlite:///./aipulse.db

# AI Mode: "mock" (offline fallback) or "live" (calls Groq API)
AI_MODE=mock

# Groq API configuration (Required when AI_MODE=live)
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
